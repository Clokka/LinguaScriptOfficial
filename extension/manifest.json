{
  "manifest_version": 3,
  "name": "LinguaScript: Learn Languages with YouTube & Netflix",
  "short_name": "LinguaScript",
  "version": "1.6.1",
  "description": "Learn languages on YouTube, Netflix, TV5MONDE and Crunchyroll. Dual subtitles, tap or highlight any word, and save it to your LinguaScript flashcards.",
  "homepage_url": "https://linguascript.co.uk",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.netflix.com/*",
    "https://ffephracinqeylfhqkiz.supabase.co/*",
    "https://translate.googleapis.com/*",
    "https://*.tv5mondeplus.com/*",
    "https://*.tv5monde.com/*",
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ls-core.js",
        "adapters/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "ls-core.js",
        "adapters/netflix.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.tv5mondeplus.com/*",
        "https://*.tv5monde.com/*",
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*"
      ],
      "js": [
        "ls-core.js",
        "adapters/stream.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://linguascript.co.uk/*",
        "https://www.linguascript.co.uk/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinguaScript",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Read this page with LinguaScript"
    }
  }
}