{
  "manifest_version": 3,
  "name": "LinguaScript: Learn Languages with YouTube & Netflix",
  "short_name": "LinguaScript",
  "version": "1.2.0",
  "description": "Learn a language from YouTube and Netflix. Dual subtitles, tap any word for its meaning, and save it to your LinguaScript flashcards.",
  "homepage_url": "https://linguascript.co.uk",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.netflix.com/*",
    "https://ffephracinqeylfhqkiz.supabase.co/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ls-core.js",
        "adapters/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "ls-core.js",
        "adapters/netflix.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinguaScript",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
