{
  "expo": {
    "name": "LinguaScript",
    "slug": "linguascript-chameleon",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "linguascript",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1215"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.linguascript.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationUsageDescription": "LinguaScript sends daily study reminders and flashcard due notifications.",
        "NSMicrophoneUsageDescription": "LinguaScript listens while you do the 3-minute speaking challenge.",
        "NSSpeechRecognitionUsageDescription": "LinguaScript turns your speech into words so it can colour them red, orange and green."
      }
    },
    "android": {
      "package": "uk.co.LinguaScript.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0b1215"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "INTERNET",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "linguascript"
            }
          ]
        },
        {
          "autoVerify": true,
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "linguascript.co.uk",
              "pathPrefix": "/gift"
            },
            {
              "scheme": "https",
              "host": "linguascript.co.uk",
              "pathPrefix": "/friends"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#22c55e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b1215"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER_REVERSED_CLIENT_ID"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 34,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "LinguaScript listens while you do the 3-minute speaking challenge.",
          "speechRecognitionPermission": "LinguaScript turns your speech into words so it can colour them red, orange and green.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "rowanawesome1s-team",
    "extra": {
      "eas": {
        "projectId": "15c4a3cd-b8c2-47c3-aaa5-1977b72f1376"
      }
    }
  }
}
