<?xml version="1.0" encoding="utf-8"?>
<!-- 🦎 Home-screen widget (DeckWidget.kt). Tap anywhere → flashcards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ls_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:background="@drawable/ls_widget_bg" android:padding="12dp">

  <ImageView
      android:layout_width="40dp" android:layout_height="40dp"
      android:src="@mipmap/ic_launcher_round"
      android:contentDescription="LinguaScript" />

  <LinearLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:orientation="horizontal">
    <TextView
        android:id="@+id/ls_count_red"
        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
        android:background="@drawable/ls_sq_red"
        android:gravity="center" android:text="0"
        android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/ls_count_orange"
        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
        android:background="@drawable/ls_sq_orange"
        android:gravity="center" android:text="0"
        android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/ls_count_green"
        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
        android:background="@drawable/ls_sq_green"
        android:gravity="center" android:text="0"
        android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
  </LinearLayout>

  <TextView
      android:id="@+id/ls_glance"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="6dp" android:gravity="center"
      android:maxLines="1" android:ellipsize="end"
      android:textColor="#FFE8EAED" android:textSize="12sp" android:visibility="gone" />

  <TextView
      android:id="@+id/ls_gold"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="6dp" android:background="@drawable/ls_gold_bar"
      android:gravity="center" android:maxLines="1" android:ellipsize="end"
      android:paddingTop="3dp" android:paddingBottom="3dp"
      android:paddingStart="8dp" android:paddingEnd="8dp"
      android:text="✨ Reviews"
      android:textColor="#FF3A2A00" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
