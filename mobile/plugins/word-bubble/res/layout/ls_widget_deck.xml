<?xml version="1.0" encoding="utf-8"?>
<!-- 🦎 Home-screen widget (DeckWidget.kt), 4×2.
     Top: the gold chameleon + how many gold words are ready to turn blue + Review.
     Middle: the blue bar (words you 100% know).
     Bottom: the five chameleons — red, orange, green, gold, blue — with counts; tap one → that deck. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ls_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ls_widget_bg"
    android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="12dp" android:paddingBottom="12dp">

  <LinearLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView
        android:layout_width="72dp" android:layout_height="36dp"
        android:src="@drawable/ls_cham_gold"
        android:contentDescription="Gold chameleon" />
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="10dp" android:orientation="vertical">
      <TextView
          android:id="@+id/ls_gold_count"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:maxLines="1" android:text="0 gold"
          android:textColor="#FFF5C542" android:textSize="20sp" android:textStyle="bold" />
      <TextView
          android:id="@+id/ls_gold_sub"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:maxLines="1" android:ellipsize="end" android:text="words ready to turn blue"
          android:textColor="#FFC9CED8" android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/ls_review"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/ls_pill_gold"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        android:text="Review"
        android:textColor="#FF2B2000" android:textSize="14sp" android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:orientation="horizontal">
    <TextView
        android:id="@+id/ls_blue_label"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:maxLines="1" android:ellipsize="end" android:text="0 blue · 100% known"
        android:textColor="#FF6FA3FF" android:textSize="12sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/ls_blue_pct"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1" android:text=""
        android:textColor="#FFC9D6EE" android:textSize="12sp" />
  </LinearLayout>

  <ProgressBar
      android:id="@+id/ls_blue_bar"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent" android:layout_height="6dp"
      android:layout_marginTop="4dp"
      android:max="100" android:progress="0"
      android:progressDrawable="@drawable/ls_progress_blue" />

  <LinearLayout
      android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:layout_marginTop="8dp" android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/ls_cell_red"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginEnd="4dp" android:background="@drawable/ls_cell_bg"
        android:orientation="vertical" android:gravity="center">
      <ImageView android:layout_width="40dp" android:layout_height="20dp" android:src="@drawable/ls_cham_red" android:contentDescription="Red" />
      <TextView android:id="@+id/ls_count_red" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFF6B62" android:textSize="14sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="red" android:textColor="#FF9AA3B2" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ls_cell_orange"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/ls_cell_bg"
        android:orientation="vertical" android:gravity="center">
      <ImageView android:layout_width="40dp" android:layout_height="20dp" android:src="@drawable/ls_cham_orange" android:contentDescription="Orange" />
      <TextView android:id="@+id/ls_count_orange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFB340" android:textSize="14sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="orange" android:textColor="#FF9AA3B2" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ls_cell_green"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/ls_cell_bg"
        android:orientation="vertical" android:gravity="center">
      <ImageView android:layout_width="40dp" android:layout_height="20dp" android:src="@drawable/ls_cham_green" android:contentDescription="Green" />
      <TextView android:id="@+id/ls_count_green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FF4CD471" android:textSize="14sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="green" android:textColor="#FF9AA3B2" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ls_cell_gold"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/ls_cell_gold"
        android:orientation="vertical" android:gravity="center">
      <ImageView android:layout_width="40dp" android:layout_height="20dp" android:src="@drawable/ls_cham_gold" android:contentDescription="Gold" />
      <TextView android:id="@+id/ls_count_gold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFF5C542" android:textSize="14sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="gold" android:textColor="#FFC9C2A8" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ls_cell_blue"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="4dp" android:background="@drawable/ls_cell_bg"
        android:orientation="vertical" android:gravity="center">
      <ImageView android:layout_width="40dp" android:layout_height="20dp" android:src="@drawable/ls_cham_blue" android:contentDescription="Blue" />
      <TextView android:id="@+id/ls_count_blue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FF6FA3FF" android:textSize="14sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="blue" android:textColor="#FF9AA3B2" android:textSize="10sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
