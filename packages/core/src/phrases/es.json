    { "id": "es-a1-08", "level": "A1", "fn": "Ask the price", "topic": "shopping", "text": "¿Cuánto cuesta esto?", "en": "How much is this?", "keys": ["cuánto", "cuesta|cuestan"], "parts": [["¿Cuánto", "question"], ["cuesta", "verb"], ["esto?", "object"]], "swap": { "role": "object", "options": ["el billete?", "la camiseta?", "un café?"] } },
    { "id": "es-a1-09", "level": "A1", "fn": "Ask where something is", "topic": "travel", "text": "¿Dónde está el baño?", "en": "Where is the bathroom?", "keys": ["dónde", "está"], "parts": [["¿Dónde", "question"], ["está", "verb"], ["el baño?", "object"]], "swap": { "role": "object", "options": ["la estación?", "el hotel?", "la playa?"] } },
    { "id": "es-a1-10", "level": "A1", "fn": "Say you don't understand", "topic": "classroom", "text": "No entiendo, ¿puedes repetir?", "en": "I don't understand, can you repeat?", "keys": ["entiendo", "puedes|puede"], "parts": [["No", "negation"], ["entiendo", "verb"], ["¿puedes", "verb"], ["repetir?", "infinitive"]], "swap": { "role": "infinitive", "options": ["hablar más despacio?", "escribirlo?", "ayudarme?"] } },
    { "id": "es-a1-11", "level": "A1", "fn": "Say what you have", "topic": "family", "text": "Tengo dos hermanos.", "en": "I have two brothers.", "keys": ["tengo|tienes|tiene"], "parts": [["Tengo", "verb"], ["dos hermanos", "object"]], "swap": { "role": "object", "options": ["un perro", "una hermana", "veinte años"] } },
    { "id": "es-a1-12", "level": "A1", "fn": "Say what you do every day", "topic": "daily life", "text": "Todos los días trabajo por la mañana.", "en": "Every day I work in the morning.", "keys": ["todos", "días", "trabajo"], "parts": [["Todos los días", "time"], ["trabajo", "verb"], ["por la mañana", "time"]], "swap": { "role": "verb", "options": ["estudio", "corro", "leo"] } },

    { "id": "es-a2-01", "level": "A2", "fn": "Talk about your weekend", "topic": "past", "text": "El fin de semana fui a la playa.", "en": "At the weekend I went to the beach.", "keys": ["fin", "semana", "fui|fuiste|fue"], "parts": [["El fin de semana", "time"], ["fui", "verb"], ["a la playa", "place"]], "swap": { "role": "place", "options": ["al cine", "a casa de mi madre", "a un concierto"] } },
    { "id": "es-a2-02", "level": "A2", "fn": "Make plans", "topic": "plans", "text": "Mañana voy a ver una película.", "en": "Tomorrow I'm going to watch a film.", "keys": ["mañana", "voy|vas|va", "ver"], "parts": [["Mañana", "time"], ["voy a", "verb"], ["ver", "infinitive"], ["una película", "object"]], "swap": { "role": "infinitive", "options": ["comer", "visitar", "estudiar"] } },
    { "id": "es-a2-03", "level": "A2", "fn": "Invite someone", "topic": "social", "text": "¿Quieres tomar algo esta noche?", "en": "Do you want to grab a drink tonight?", "keys": ["quieres", "tomar", "noche"], "parts": [["¿Quieres", "verb"], ["tomar algo", "infinitive"], ["esta noche?", "time"]], "swap": { "role": "time", "options": ["mañana?", "el sábado?", "después del trabajo?"] } },
    { "id": "es-a2-04", "level": "A2", "fn": "Accept an invitation", "topic": "social", "text": "¡Claro! Me parece genial.", "en": "Sure! Sounds great.", "keys": ["claro", "parece", "genial"], "parts": [["¡Claro!", "reaction"], ["Me", "pronoun"], ["parece", "verb"], ["genial", "adjective"]], "swap": { "role": "adjective", "options": ["perfecto", "muy bien", "una buena idea"] } },
    { "id": "es-a2-05", "level": "A2", "fn": "Decline politely", "topic": "social", "text": "Lo siento, hoy no puedo.", "en": "Sorry, I can't today.", "keys": ["siento", "hoy", "puedo"], "parts": [["Lo siento", "politeness"], ["hoy", "time"], ["no", "negation"], ["puedo", "verb"]], "swap": { "role": "time", "options": ["esta semana", "el viernes", "ahora"] } },
    { "id": "es-a2-06", "level": "A2", "fn": "Compare things", "topic": "opinions", "text": "Este es más barato que el otro.", "en": "This one is cheaper than the other one.", "keys": ["más", "que", "otro"], "parts": [["Este", "subject"], ["es", "verb"], ["más barato", "comparison"], ["que el otro", "object"]], "swap": { "role": "comparison", "options": ["más bonito", "mejor", "más grande"] } },
    { "id": "es-a2-07", "level": "A2", "fn": "Talk about experiences", "topic": "past", "text": "Nunca he estado en México.", "en": "I've never been to Mexico.", "keys": ["nunca", "he|has|ha", "estado"], "parts": [["Nunca", "adverb"], ["he estado", "verb"], ["en México", "place"]], "swap": { "role": "place", "options": ["en Japón", "en un festival", "en Barcelona"] } },
    { "id": "es-a2-08", "level": "A2", "fn": "Describe how you feel", "topic": "feelings", "text": "Estoy un poco cansado hoy.", "en": "I'm a bit tired today.", "keys": ["estoy|estás|está", "poco", "cansado|cansada"], "parts": [["Estoy", "verb"], ["un poco", "adverb"], ["cansado", "adjective"], ["hoy", "time"]], "swap": { "role": "adjective", "options": ["nervioso", "contento", "enfermo"] } },
