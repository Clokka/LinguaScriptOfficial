    { "id": "es-a2-10", "level": "A2", "fn": "Order food", "topic": "food", "text": "Para mí, la paella, por favor.", "en": "For me, the paella, please.", "keys": ["para", "mí"], "parts": [["Para mí", "politeness"], ["la paella", "object"], ["por favor", "politeness"]], "swap": { "role": "object", "options": ["el pescado", "una ensalada", "lo mismo"] } },
    { "id": "es-a2-11", "level": "A2", "fn": "Say how long", "topic": "daily life", "text": "Llevo dos años estudiando español.", "en": "I've been learning Spanish for two years.", "keys": ["llevo", "años", "estudiando"], "parts": [["Llevo", "verb"], ["dos años", "time"], ["estudiando español", "gerund"]], "swap": { "role": "gerund", "options": ["trabajando aquí", "viviendo en Madrid", "jugando al tenis"] } },
    { "id": "es-a2-12", "level": "A2", "fn": "Say what you need", "topic": "daily life", "text": "Necesito ayuda con esto.", "en": "I need help with this.", "keys": ["necesito", "ayuda"], "parts": [["Necesito", "verb"], ["ayuda", "object"], ["con esto", "complement"]], "swap": { "role": "object", "options": ["un taxi", "más tiempo", "dormir"] } },

    { "id": "es-b1-01", "level": "B1", "fn": "Give your opinion", "topic": "opinions", "text": "Creo que es una buena idea.", "en": "I think it's a good idea.", "keys": ["creo", "que", "idea"], "parts": [["Creo que", "opinion"], ["es", "verb"], ["una buena idea", "complement"]], "swap": { "role": "opinion", "options": ["Pienso que", "Me parece que", "Para mí"] } },
    { "id": "es-b1-02", "level": "B1", "fn": "Agree", "topic": "opinions", "text": "Tienes toda la razón.", "en": "You're absolutely right.", "keys": ["tienes", "toda", "razón"], "parts": [["Tienes", "verb"], ["toda la razón", "object"]], "swap": { "role": "verb", "options": ["Tiene", "Tenéis", "Tienen"] } },
    { "id": "es-b1-03", "level": "B1", "fn": "Disagree politely", "topic": "opinions", "text": "No estoy de acuerdo contigo.", "en": "I don't agree with you.", "keys": ["estoy", "acuerdo"], "parts": [["No", "negation"], ["estoy de acuerdo", "verb"], ["contigo", "complement"]], "swap": { "role": "complement", "options": ["del todo", "con esa idea", "en eso"] } },
    { "id": "es-b1-04", "level": "B1", "fn": "Express a hope", "topic": "future", "text": "Espero que tengas un buen viaje.", "en": "I hope you have a good trip.", "keys": ["espero", "que", "viaje"], "parts": [["Espero que", "wish"], ["tengas", "verb"], ["un buen viaje", "object"]], "swap": { "role": "object", "options": ["un buen día", "suerte", "un buen fin de semana"] } },
    { "id": "es-b1-05", "level": "B1", "fn": "Give advice", "topic": "advice", "text": "Deberías descansar un poco más.", "en": "You should rest a bit more.", "keys": ["deberías|debería", "poco", "más"], "parts": [["Deberías", "verb"], ["descansar", "infinitive"], ["un poco más", "adverb"]], "swap": { "role": "infinitive", "options": ["dormir", "salir", "hablar con ella"] } },
    { "id": "es-b1-06", "level": "B1", "fn": "Tell a story", "topic": "past", "text": "Cuando era pequeño, vivía en el campo.", "en": "When I was little, I lived in the countryside.", "keys": ["cuando", "era", "vivía"], "parts": [["Cuando era pequeño", "time"], ["vivía", "verb"], ["en el campo", "place"]], "swap": { "role": "verb", "options": ["jugaba", "leía mucho", "nadaba"] } },
