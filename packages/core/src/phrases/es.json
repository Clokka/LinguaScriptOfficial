    { "id": "es-a1-05", "level": "A1", "fn": "Say what you like", "topic": "likes", "text": "Me gusta mucho el fútbol.", "en": "I really like football.", "keys": ["gusta|gustan", "mucho"], "parts": [["Me", "pronoun"], ["gusta", "verb"], ["mucho", "adverb"], ["el fútbol", "object"]], "swap": { "role": "object", "options": ["la música", "viajar", "leer", "el cine"] } },
    { "id": "es-a1-06", "level": "A1", "fn": "Say what you don't like", "topic": "likes", "text": "No me gusta nada el café.", "en": "I don't like coffee at all.", "keys": ["no", "gusta", "nada"], "parts": [["No", "negation"], ["me", "pronoun"], ["gusta", "verb"], ["nada", "adverb"], ["el café", "object"]], "swap": { "role": "object", "options": ["el frío", "madrugar", "el té"] } },
