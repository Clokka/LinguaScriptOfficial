    { "id": "es-a1-03", "level": "A1", "fn": "Say where you're from", "topic": "introductions", "text": "Soy de Inglaterra.", "en": "I'm from England.", "keys": ["soy|eres|es", "de"], "parts": [["Soy", "verb"], ["de", "preposition"], ["Inglaterra", "place"]], "swap": { "role": "place", "options": ["Escocia", "Irlanda", "Londres"] } },
