    { "id": "es-b1-08", "level": "B1", "fn": "Check understanding", "topic": "conversation", "text": "¿Quieres decir que no vienes?", "en": "Do you mean you're not coming?", "keys": ["quieres", "decir", "vienes"], "parts": [["¿Quieres decir", "question"], ["que", "connector"], ["no vienes?", "verb"]], "swap": { "role": "verb", "options": ["está cerrado?", "ya lo sabes?", "hay que pagar?"] } },
    { "id": "es-b1-09", "level": "B1", "fn": "Say what you've just done", "topic": "past", "text": "Acabo de llegar a casa.", "en": "I've just got home.", "keys": ["acabo", "llegar", "casa"], "parts": [["Acabo de", "verb"], ["llegar", "infinitive"], ["a casa", "place"]], "swap": { "role": "infinitive", "options": ["comer", "terminar", "despertarme"] } },
