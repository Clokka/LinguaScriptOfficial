    { "id": "es-b1-11", "level": "B1", "fn": "Talk about a goal", "topic": "future", "text": "Me gustaría hablar español con fluidez.", "en": "I'd like to speak Spanish fluently.", "keys": ["gustaría", "hablar"], "parts": [["Me gustaría", "wish"], ["hablar", "infinitive"], ["español con fluidez", "object"]], "swap": { "role": "infinitive", "options": ["viajar por Sudamérica", "vivir en España", "entender las películas"] } },
    { "id": "es-b1-12", "level": "B1", "fn": "Make a complaint", "topic": "services", "text": "Perdone, pero esto no funciona.", "en": "Excuse me, but this doesn't work.", "keys": ["perdone|perdona", "pero", "funciona"], "parts": [["Perdone", "politeness"], ["pero", "connector"], ["esto", "subject"], ["no funciona", "verb"]], "swap": { "role": "subject", "options": ["la ducha", "el wifi", "la tarjeta"] } },

    { "id": "es-b2-01", "level": "B2", "fn": "Speculate", "topic": "opinions", "text": "Puede que llegue tarde por el tráfico.", "en": "He might be late because of the traffic.", "keys": ["puede", "llegue", "tarde"], "parts": [["Puede que", "speculation"], ["llegue tarde", "verb"], ["por el tráfico", "reason"]], "swap": { "role": "reason", "options": ["por la lluvia", "por la huelga", "por el trabajo"] } },
    { "id": "es-b2-02", "level": "B2", "fn": "Talk hypothetically", "topic": "hypotheses", "text": "Si tuviera más tiempo, aprendería a tocar la guitarra.", "en": "If I had more time, I'd learn to play the guitar.", "keys": ["si", "tuviera", "tiempo"], "parts": [["Si tuviera más tiempo", "condition"], ["aprendería", "verb"], ["a tocar la guitarra", "object"]], "swap": { "role": "condition", "options": ["Si tuviera dinero", "Si viviera cerca", "Si fuera tú"] } },
    { "id": "es-b2-03", "level": "B2", "fn": "Weigh up pros and cons", "topic": "opinions", "text": "Por un lado es caro, pero por otro lado merece la pena.", "en": "On the one hand it's expensive, but on the other it's worth it.", "keys": ["lado", "otro", "merece", "pena"], "parts": [["Por un lado", "connector"], ["es caro", "complement"], ["pero por otro lado", "connector"], ["merece la pena", "verb"]], "swap": { "role": "complement", "options": ["es difícil", "está lejos", "lleva tiempo"] } },
    { "id": "es-b2-04", "level": "B2", "fn": "Express certainty and doubt", "topic": "opinions", "text": "Dudo que lo terminen a tiempo.", "en": "I doubt they'll finish it on time.", "keys": ["dudo", "tiempo"], "parts": [["Dudo que", "doubt"], ["lo terminen", "verb"], ["a tiempo", "time"]], "swap": { "role": "doubt", "options": ["No creo que", "Es posible que", "Me extrañaría que"] } },
    { "id": "es-b2-05", "level": "B2", "fn": "Express regret", "topic": "feelings", "text": "Ojalá hubiera estudiado más.", "en": "I wish I'd studied more.", "keys": ["ojalá", "hubiera"], "parts": [["Ojalá", "wish"], ["hubiera estudiado", "verb"], ["más", "adverb"]], "swap": { "role": "verb", "options": ["hubiera ido", "hubiera dicho la verdad", "hubiera llamado"] } },
    { "id": "es-b2-06", "level": "B2", "fn": "Persuade", "topic": "persuasion", "text": "Te aseguro que no te vas a arrepentir.", "en": "I promise you won't regret it.", "keys": ["aseguro", "arrepentir"], "parts": [["Te aseguro que", "persuasion"], ["no te vas a arrepentir", "verb"]], "swap": { "role": "persuasion", "options": ["Estoy convencido de que", "Ya verás que", "Créeme,"] } },
    { "id": "es-b2-07", "level": "B2", "fn": "Report what someone said", "topic": "conversation", "text": "Me dijo que vendría más tarde.", "en": "She told me she'd come later.", "keys": ["dijo", "vendría", "tarde"], "parts": [["Me dijo que", "report"], ["vendría", "verb"], ["más tarde", "time"]], "swap": { "role": "verb", "options": ["llamaría", "lo haría", "estaba ocupada"] } },
    { "id": "es-b2-08", "level": "B2", "fn": "Clarify what you meant", "topic": "conversation", "text": "Lo que quiero decir es que necesitamos un plan.", "en": "What I mean is that we need a plan.", "keys": ["quiero", "decir", "necesitamos"], "parts": [["Lo que quiero decir es que", "clarify"], ["necesitamos", "verb"], ["un plan", "object"]], "swap": { "role": "object", "options": ["más tiempo", "otra opción", "hablar"] } },
    { "id": "es-b2-09", "level": "B2", "fn": "Set a condition", "topic": "negotiation", "text": "Vale, siempre que me avises antes.", "en": "OK, as long as you let me know first.", "keys": ["vale", "siempre", "avises"], "parts": [["Vale", "reaction"], ["siempre que", "condition"], ["me avises antes", "verb"]], "swap": { "role": "condition", "options": ["con tal de que", "a menos que no", "solo si"] } },
    { "id": "es-b2-10", "level": "B2", "fn": "Talk about changes", "topic": "life", "text": "Desde que me mudé, me siento mucho mejor.", "en": "Since I moved, I feel much better.", "keys": ["desde", "mudé", "siento"], "parts": [["Desde que me mudé", "time"], ["me siento", "verb"], ["mucho mejor", "complement"]], "swap": { "role": "time", "options": ["Desde que corro", "Desde que dejé el trabajo", "Desde que vivo sola"] } },
    { "id": "es-b2-11", "level": "B2", "fn": "Give a strong recommendation", "topic": "advice", "text": "Te recomiendo que la veas en versión original.", "en": "I recommend you watch it in the original language.", "keys": ["recomiendo", "veas"], "parts": [["Te recomiendo que", "advice"], ["la veas", "verb"], ["en versión original", "complement"]], "swap": { "role": "complement", "options": ["cuanto antes", "con subtítulos", "con amigos"] } },
    { "id": "es-b2-12", "level": "B2", "fn": "Show you're following", "topic": "conversation", "text": "Ya veo, o sea que al final no fuiste.", "en": "I see, so in the end you didn't go.", "keys": ["veo", "sea", "final"], "parts": [["Ya veo", "reaction"], ["o sea que", "connector"], ["al final", "time"], ["no fuiste", "verb"]], "swap": { "role": "verb", "options": ["te quedaste", "lo compraste", "ganaron"] } },

    { "id": "es-c1-01", "level": "C1", "fn": "Hedge an opinion", "topic": "opinions", "text": "Hasta cierto punto, entiendo su postura.", "en": "To some extent, I understand their position.", "keys": ["hasta", "cierto", "punto"], "parts": [["Hasta cierto punto", "hedge"], ["entiendo", "verb"], ["su postura", "object"]], "swap": { "role": "hedge", "options": ["En parte", "En cierto modo", "Si lo miras así"] } },
    { "id": "es-c1-02", "level": "C1", "fn": "Concede a point", "topic": "debate", "text": "Si bien es cierto, no lo cambia todo.", "en": "While that's true, it doesn't change everything.", "keys": ["bien", "cierto", "cambia"], "parts": [["Si bien es cierto", "concession"], ["no lo cambia", "verb"], ["todo", "object"]], "swap": { "role": "concession", "options": ["Aun así", "Aunque tienes razón", "Eso es verdad, pero"] } },
    { "id": "es-c1-03", "level": "C1", "fn": "Bring up a topic", "topic": "conversation", "text": "A propósito, ¿sabes algo de Marta?", "en": "By the way, have you heard from Marta?", "keys": ["propósito", "sabes"], "parts": [["A propósito", "connector"], ["¿sabes algo", "verb"], ["de Marta?", "object"]], "swap": { "role": "connector", "options": ["Por cierto", "Cambiando de tema", "Hablando de eso"] } },
    { "id": "es-c1-04", "level": "C1", "fn": "Emphasise", "topic": "opinions", "text": "Lo que más me preocupa es la falta de tiempo.", "en": "What worries me most is the lack of time.", "keys": ["preocupa", "falta"], "parts": [["Lo que más me preocupa", "emphasis"], ["es", "verb"], ["la falta de tiempo", "complement"]], "swap": { "role": "complement", "options": ["el precio", "la distancia", "la presión"] } },
    { "id": "es-c1-05", "level": "C1", "fn": "Buy time to think", "topic": "conversation", "text": "Pues, a ver, déjame pensarlo un momento.", "en": "Well, let me see, let me think about it for a moment.", "keys": ["pues", "déjame", "momento"], "parts": [["Pues, a ver", "filler"], ["déjame pensarlo", "verb"], ["un momento", "time"]], "swap": { "role": "filler", "options": ["Bueno", "Mmm, no sé", "Es que"] } },
    { "id": "es-c1-06", "level": "C1", "fn": "Give a nuanced comparison", "topic": "opinions", "text": "No es tanto el dinero como el tiempo que se pierde.", "en": "It's not so much the money as the time wasted.", "keys": ["tanto", "como", "pierde"], "parts": [["No es tanto", "comparison"], ["el dinero", "object"], ["como el tiempo que se pierde", "comparison"]], "swap": { "role": "object", "options": ["el esfuerzo", "la distancia", "el trabajo"] } },
    { "id": "es-c1-07", "level": "C1", "fn": "Express mild criticism", "topic": "feedback", "text": "No está mal, aunque se podría mejorar.", "en": "It's not bad, though it could be improved.", "keys": ["mal", "aunque", "podría"], "parts": [["No está mal", "evaluation"], ["aunque", "connector"], ["se podría mejorar", "verb"]], "swap": { "role": "verb", "options": ["le falta algo", "es un poco largo", "yo lo cambiaría"] } },
    { "id": "es-c1-08", "level": "C1", "fn": "Summarise", "topic": "conversation", "text": "En resumen, lo mejor es esperar.", "en": "In short, the best thing is to wait.", "keys": ["resumen", "mejor", "esperar"], "parts": [["En resumen", "connector"], ["lo mejor es", "evaluation"], ["esperar", "infinitive"]], "swap": { "role": "connector", "options": ["En definitiva", "Al fin y al cabo", "Total, que"] } },
    { "id": "es-c1-09", "level": "C1", "fn": "Talk about consequences", "topic": "debate", "text": "Como consecuencia, tuvimos que cancelarlo todo.", "en": "As a result, we had to cancel everything.", "keys": ["consecuencia", "tuvimos"], "parts": [["Como consecuencia", "connector"], ["tuvimos que", "verb"], ["cancelarlo todo", "infinitive"]], "swap": { "role": "connector", "options": ["Por eso", "Así que", "De ahí que"] } },
    { "id": "es-c1-10", "level": "C1", "fn": "Interrupt politely", "topic": "conversation", "text": "Perdona que te interrumpa, pero tengo una duda.", "en": "Sorry to interrupt, but I have a question.", "keys": ["perdona", "interrumpa", "duda"], "parts": [["Perdona que te interrumpa", "politeness"], ["pero", "connector"], ["tengo una duda", "verb"]], "swap": { "role": "verb", "options": ["se nos acaba el tiempo", "no estoy de acuerdo", "quería añadir algo"] } },
    { "id": "es-c1-11", "level": "C1", "fn": "Express indifference", "topic": "feelings", "text": "Me da igual, decide tú.", "en": "I don't mind, you decide.", "keys": ["igual", "decide"], "parts": [["Me da igual", "reaction"], ["decide tú", "verb"]], "swap": { "role": "verb", "options": ["lo que tú quieras", "cualquiera vale", "elige tú"] } },
    { "id": "es-c1-12", "level": "C1", "fn": "Keep a promise vague", "topic": "social", "text": "Haré lo posible por estar allí.", "en": "I'll do my best to be there.", "keys": ["haré", "posible"], "parts": [["Haré lo posible", "verb"], ["por estar allí", "complement"]], "swap": { "role": "complement", "options": ["por terminarlo", "por llegar a tiempo", "por ayudarte"] } },

    { "id": "es-c2-01", "level": "C2", "fn": "Use an idiom", "topic": "idioms", "text": "No hay mal que por bien no venga.", "en": "Every cloud has a silver lining.", "keys": ["mal", "bien", "venga"], "parts": [["No hay mal", "subject"], ["que por bien", "complement"], ["no venga", "verb"]], "swap": null },
    { "id": "es-c2-02", "level": "C2", "fn": "Downplay something", "topic": "conversation", "text": "Tampoco es para tanto.", "en": "It's not that big a deal.", "keys": ["tampoco", "tanto"], "parts": [["Tampoco", "adverb"], ["es", "verb"], ["para tanto", "complement"]], "swap": { "role": "complement", "options": ["para ponerse así", "tan grave", "el fin del mundo"] } },
    { "id": "es-c2-03", "level": "C2", "fn": "Reformulate precisely", "topic": "conversation", "text": "Mejor dicho, no es que no quiera, es que no puedo.", "en": "Or rather, it's not that I don't want to, it's that I can't.", "keys": ["dicho", "quiera", "puedo"], "parts": [["Mejor dicho", "clarify"], ["no es que no quiera", "contrast"], ["es que no puedo", "reason"]], "swap": { "role": "reason", "options": ["es que no me dejan", "es que no tengo tiempo", "es que no sé"] } },
    { "id": "es-c2-04", "level": "C2", "fn": "Sound ironic", "topic": "humour", "text": "¡Qué bien, justo lo que necesitaba!", "en": "Great, just what I needed!", "keys": ["justo", "necesitaba"], "parts": [["¡Qué bien!", "reaction"], ["justo lo que", "emphasis"], ["necesitaba", "verb"]], "swap": { "role": "reaction", "options": ["¡Genial!", "¡Perfecto!", "¡Lo que faltaba!"] } },
    { "id": "es-c2-05", "level": "C2", "fn": "Express resignation", "topic": "feelings", "text": "Es lo que hay, no le des más vueltas.", "en": "It is what it is, stop overthinking it.", "keys": ["hay", "vueltas"], "parts": [["Es lo que hay", "reaction"], ["no le des más vueltas", "verb"]], "swap": { "role": "verb", "options": ["toca aguantarse", "hay que seguir", "ya pasará"] } },
    { "id": "es-c2-06", "level": "C2", "fn": "Make a subtle suggestion", "topic": "persuasion", "text": "No estaría de más pedir una segunda opinión.", "en": "It wouldn't hurt to get a second opinion.", "keys": ["estaría", "más", "opinión"], "parts": [["No estaría de más", "suggestion"], ["pedir", "infinitive"], ["una segunda opinión", "object"]], "swap": { "role": "object", "options": ["más información", "ayuda", "un descuento"] } },
    { "id": "es-c2-07", "level": "C2", "fn": "Stress an exception", "topic": "debate", "text": "Salvo contadas excepciones, todos estuvieron de acuerdo.", "en": "With very few exceptions, everyone agreed.", "keys": ["salvo", "excepciones"], "parts": [["Salvo contadas excepciones", "exception"], ["todos", "subject"], ["estuvieron de acuerdo", "verb"]], "swap": { "role": "verb", "options": ["votaron a favor", "vinieron", "lo aceptaron"] } },
    { "id": "es-c2-08", "level": "C2", "fn": "Defend a view firmly", "topic": "debate", "text": "Por mucho que insistas, no voy a cambiar de opinión.", "en": "However much you insist, I won't change my mind.", "keys": ["mucho", "insistas", "opinión"], "parts": [["Por mucho que insistas", "concession"], ["no voy a cambiar", "verb"], ["de opinión", "object"]], "swap": { "role": "concession", "options": ["Digas lo que digas", "Aunque me lo pidas", "Por más que lo intentes"] } },
    { "id": "es-c2-09", "level": "C2", "fn": "Show empathy", "topic": "feelings", "text": "Me hago cargo de lo difícil que tiene que ser.", "en": "I can appreciate how hard it must be.", "keys": ["cargo", "difícil"], "parts": [["Me hago cargo de", "empathy"], ["lo difícil", "complement"], ["que tiene que ser", "verb"]], "swap": { "role": "complement", "options": ["lo duro", "lo agotador", "lo complicado"] } },
    { "id": "es-c2-10", "level": "C2", "fn": "Signal a change of view", "topic": "debate", "text": "Pensándolo bien, quizá tengas razón.", "en": "On second thoughts, maybe you're right.", "keys": ["pensándolo", "quizá", "razón"], "parts": [["Pensándolo bien", "reconsider"], ["quizá", "hedge"], ["tengas razón", "verb"]], "swap": { "role": "verb", "options": ["sea mejor esperar", "no merezca la pena", "lo dejemos"] } },
    { "id": "es-c2-11", "level": "C2", "fn": "Emphasise from every angle", "topic": "conversation", "text": "Se mire por donde se mire, es un error.", "en": "Whichever way you look at it, it's a mistake.", "keys": ["mire", "donde", "error"], "parts": [["Se mire por donde se mire", "emphasis"], ["es", "verb"], ["un error", "complement"]], "swap": { "role": "complement", "options": ["injusto", "una oportunidad", "demasiado caro"] } },
    { "id": "es-c2-12", "level": "C2", "fn": "Close a discussion gracefully", "topic": "conversation", "text": "Dejémoslo aquí y lo retomamos mañana.", "en": "Let's leave it here and pick it up tomorrow.", "keys": ["dejémoslo", "retomamos", "mañana"], "parts": [["Dejémoslo aquí", "verb"], ["y lo retomamos", "verb"], ["mañana", "time"]], "swap": { "role": "time", "options": ["la semana que viene", "después de comer", "otro día"] } }
  ]
}
