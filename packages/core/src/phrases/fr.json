    { "id": "fr-a1-03", "level": "A1", "fn": "Say where you're from", "topic": "introductions", "text": "Je viens d'Angleterre.", "en": "I come from England.", "keys": ["viens|vient"], "parts": [["Je", "subject"], ["viens", "verb"], ["d'Angleterre", "place"]], "swap": { "role": "place", "options": ["d'Écosse", "d'Irlande", "de Londres"] } },
    { "id": "fr-a1-04", "level": "A1", "fn": "Say where you live", "topic": "introductions", "text": "J'habite dans une petite ville.", "en": "I live in a small town.", "keys": ["habite|j'habite", "ville"], "parts": [["J'", "subject"], ["habite", "verb"], ["dans une petite ville", "place"]], "swap": { "role": "place", "options": ["à Paris", "à la campagne", "près de la mer"] } },
    { "id": "fr-a1-05", "level": "A1", "fn": "Say what you like", "topic": "likes", "text": "J'aime beaucoup le football.", "en": "I really like football.", "keys": ["aime|j'aime", "beaucoup"], "parts": [["J'", "subject"], ["aime", "verb"], ["beaucoup", "adverb"], ["le football", "object"]], "swap": { "role": "object", "options": ["la musique", "voyager", "lire", "le cinéma"] } },
    { "id": "fr-a1-06", "level": "A1", "fn": "Say what you don't like", "topic": "likes", "text": "Je n'aime pas du tout le café.", "en": "I don't like coffee at all.", "keys": ["aime|n'aime", "pas", "tout"], "parts": [["Je", "subject"], ["n'aime pas", "verb"], ["du tout", "adverb"], ["le café", "object"]], "swap": { "role": "object", "options": ["le froid", "me lever tôt", "le thé"] } },
    { "id": "fr-a1-07", "level": "A1", "fn": "Ask for something", "topic": "food", "text": "Je voudrais un café, s'il vous plaît.", "en": "I'd like a coffee, please.", "keys": ["voudrais", "plaît"], "parts": [["Je", "subject"], ["voudrais", "verb"], ["un café", "object"], ["s'il vous plaît", "politeness"]], "swap": { "role": "object", "options": ["de l'eau", "une bière", "l'addition"] } },
    { "id": "fr-a1-08", "level": "A1", "fn": "Ask the price", "topic": "shopping", "text": "C'est combien ?", "en": "How much is it?", "keys": ["c'est|est", "combien"], "parts": [["C'est", "verb"], ["combien ?", "question"]], "swap": { "role": "verb", "options": ["Le billet, c'est", "Ça coûte", "Ça fait"] } },
    { "id": "fr-a1-09", "level": "A1", "fn": "Ask where something is", "topic": "travel", "text": "Où sont les toilettes ?", "en": "Where are the toilets?", "keys": ["où", "sont|est"], "parts": [["Où", "question"], ["sont", "verb"], ["les toilettes ?", "object"]], "swap": { "role": "object", "options": ["les taxis ?", "mes clés ?", "les enfants ?"] } },
    { "id": "fr-a1-10", "level": "A1", "fn": "Say you don't understand", "topic": "classroom", "text": "Je ne comprends pas, vous pouvez répéter ?", "en": "I don't understand, can you repeat?", "keys": ["comprends", "pouvez|peux"], "parts": [["Je ne comprends pas", "verb"], ["vous pouvez", "verb"], ["répéter ?", "infinitive"]], "swap": { "role": "infinitive", "options": ["parler plus lentement ?", "l'écrire ?", "m'aider ?"] } },
    { "id": "fr-a1-11", "level": "A1", "fn": "Say what you have", "topic": "family", "text": "J'ai deux frères.", "en": "I have two brothers.", "keys": ["j'ai|ai"], "parts": [["J'", "subject"], ["ai", "verb"], ["deux frères", "object"]], "swap": { "role": "object", "options": ["un chien", "une sœur", "vingt ans"] } },
    { "id": "fr-a1-12", "level": "A1", "fn": "Say what you do every day", "topic": "daily life", "text": "Tous les jours, je travaille le matin.", "en": "Every day I work in the morning.", "keys": ["tous", "jours", "travaille"], "parts": [["Tous les jours", "time"], ["je", "subject"], ["travaille", "verb"], ["le matin", "time"]], "swap": { "role": "verb", "options": ["étudie", "cours", "lis"] } },

    { "id": "fr-a2-01", "level": "A2", "fn": "Talk about your weekend", "topic": "past", "text": "Ce week-end, je suis allé à la plage.", "en": "This weekend I went to the beach.", "keys": ["week-end", "suis", "allé|allée"], "parts": [["Ce week-end", "time"], ["je", "subject"], ["suis allé", "verb"], ["à la plage", "place"]], "swap": { "role": "place", "options": ["au cinéma", "chez ma mère", "à un concert"] } },
    { "id": "fr-a2-02", "level": "A2", "fn": "Make plans", "topic": "plans", "text": "Demain, je vais voir un film.", "en": "Tomorrow I'm going to watch a film.", "keys": ["demain", "vais", "voir"], "parts": [["Demain", "time"], ["je", "subject"], ["vais", "verb"], ["voir", "infinitive"], ["un film", "object"]], "swap": { "role": "infinitive", "options": ["manger", "visiter", "étudier"] } },
    { "id": "fr-a2-03", "level": "A2", "fn": "Invite someone", "topic": "social", "text": "Tu veux boire un verre ce soir ?", "en": "Do you want to grab a drink tonight?", "keys": ["veux", "boire", "soir"], "parts": [["Tu", "subject"], ["veux", "verb"], ["boire un verre", "infinitive"], ["ce soir ?", "time"]], "swap": { "role": "time", "options": ["demain ?", "samedi ?", "après le travail ?"] } },
    { "id": "fr-a2-04", "level": "A2", "fn": "Accept an invitation", "topic": "social", "text": "Avec plaisir, c'est une super idée !", "en": "With pleasure, that's a great idea!", "keys": ["plaisir", "idée"], "parts": [["Avec plaisir", "reaction"], ["c'est", "verb"], ["une super idée !", "complement"]], "swap": { "role": "complement", "options": ["parfait !", "génial !", "une bonne idée !"] } },
    { "id": "fr-a2-05", "level": "A2", "fn": "Decline politely", "topic": "social", "text": "Désolé, je ne peux pas aujourd'hui.", "en": "Sorry, I can't today.", "keys": ["désolé|désolée", "peux", "aujourd'hui"], "parts": [["Désolé", "politeness"], ["je ne peux pas", "verb"], ["aujourd'hui", "time"]], "swap": { "role": "time", "options": ["cette semaine", "vendredi", "maintenant"] } },
    { "id": "fr-a2-06", "level": "A2", "fn": "Compare things", "topic": "opinions", "text": "Celui-ci est moins cher que l'autre.", "en": "This one is cheaper than the other one.", "keys": ["moins", "que", "autre|l'autre"], "parts": [["Celui-ci", "subject"], ["est", "verb"], ["moins cher", "comparison"], ["que l'autre", "object"]], "swap": { "role": "comparison", "options": ["plus joli", "meilleur", "plus grand"] } },
    { "id": "fr-a2-07", "level": "A2", "fn": "Talk about experiences", "topic": "past", "text": "Je ne suis jamais allé au Canada.", "en": "I've never been to Canada.", "keys": ["jamais", "allé"], "parts": [["Je", "subject"], ["ne suis jamais allé", "verb"], ["au Canada", "place"]], "swap": { "role": "place", "options": ["au Japon", "à un festival", "à Marseille"] } },
    { "id": "fr-a2-08", "level": "A2", "fn": "Describe how you feel", "topic": "feelings", "text": "Je suis un peu fatigué aujourd'hui.", "en": "I'm a bit tired today.", "keys": ["suis", "peu", "fatigué|fatiguée"], "parts": [["Je", "subject"], ["suis", "verb"], ["un peu", "adverb"], ["fatigué", "adjective"], ["aujourd'hui", "time"]], "swap": { "role": "adjective", "options": ["stressé", "content", "malade"] } },
    { "id": "fr-a2-09", "level": "A2", "fn": "Ask for directions", "topic": "travel", "text": "Pour aller au centre, s'il vous plaît ?", "en": "How do I get to the centre, please?", "keys": ["pour", "aller", "centre"], "parts": [["Pour aller", "question"], ["au centre", "place"], ["s'il vous plaît ?", "politeness"]], "swap": { "role": "place", "options": ["à l'aéroport", "à la gare", "au musée"] } },
    { "id": "fr-a2-10", "level": "A2", "fn": "Order food", "topic": "food", "text": "Pour moi, le poulet, s'il vous plaît.", "en": "For me, the chicken, please.", "keys": ["pour", "moi"], "parts": [["Pour moi", "politeness"], ["le poulet", "object"], ["s'il vous plaît", "politeness"]], "swap": { "role": "object", "options": ["le poisson", "une salade", "la même chose"] } },
    { "id": "fr-a2-11", "level": "A2", "fn": "Say how long", "topic": "daily life", "text": "J'apprends le français depuis deux ans.", "en": "I've been learning French for two years.", "keys": ["apprends|j'apprends", "depuis", "ans"], "parts": [["J'", "subject"], ["apprends", "verb"], ["le français", "object"], ["depuis deux ans", "time"]], "swap": { "role": "time", "options": ["depuis six mois", "depuis l'école", "depuis peu"] } },
    { "id": "fr-a2-12", "level": "A2", "fn": "Say what you need", "topic": "daily life", "text": "J'ai besoin d'aide avec ça.", "en": "I need help with this.", "keys": ["besoin", "aide|d'aide"], "parts": [["J'ai besoin", "verb"], ["d'aide", "object"], ["avec ça", "complement"]], "swap": { "role": "object", "options": ["d'un taxi", "de plus de temps", "de dormir"] } },

    { "id": "fr-b1-01", "level": "B1", "fn": "Give your opinion", "topic": "opinions", "text": "Je pense que c'est une bonne idée.", "en": "I think it's a good idea.", "keys": ["pense", "que", "idée"], "parts": [["Je pense que", "opinion"], ["c'est", "verb"], ["une bonne idée", "complement"]], "swap": { "role": "opinion", "options": ["Je trouve que", "À mon avis,", "Pour moi,"] } },
    { "id": "fr-b1-02", "level": "B1", "fn": "Agree", "topic": "opinions", "text": "Tu as tout à fait raison.", "en": "You're absolutely right.", "keys": ["as", "tout", "raison"], "parts": [["Tu", "subject"], ["as", "verb"], ["tout à fait", "adverb"], ["raison", "object"]], "swap": { "role": "subject", "options": ["Vous avez", "Elle a", "Ils ont"] } },
    { "id": "fr-b1-03", "level": "B1", "fn": "Disagree politely", "topic": "opinions", "text": "Je ne suis pas d'accord avec toi.", "en": "I don't agree with you.", "keys": ["suis", "accord|d'accord"], "parts": [["Je", "subject"], ["ne suis pas d'accord", "verb"], ["avec toi", "complement"]], "swap": { "role": "complement", "options": ["du tout", "avec cette idée", "là-dessus"] } },
    { "id": "fr-b1-04", "level": "B1", "fn": "Express a hope", "topic": "future", "text": "J'espère que tu feras bon voyage.", "en": "I hope you have a good trip.", "keys": ["espère|j'espère", "voyage"], "parts": [["J'espère que", "wish"], ["tu feras", "verb"], ["bon voyage", "object"]], "swap": { "role": "object", "options": ["une bonne journée", "de beaux rêves", "un bon week-end"] } },
    { "id": "fr-b1-05", "level": "B1", "fn": "Give advice", "topic": "advice", "text": "Tu devrais te reposer un peu plus.", "en": "You should rest a bit more.", "keys": ["devrais|devriez", "peu", "plus"], "parts": [["Tu", "subject"], ["devrais", "verb"], ["te reposer", "infinitive"], ["un peu plus", "adverb"]], "swap": { "role": "infinitive", "options": ["dormir", "sortir", "lui parler"] } },
    { "id": "fr-b1-06", "level": "B1", "fn": "Tell a story", "topic": "past", "text": "Quand j'étais petit, j'habitais à la campagne.", "en": "When I was little, I lived in the countryside.", "keys": ["quand", "étais|j'étais", "habitais|j'habitais"], "parts": [["Quand j'étais petit", "time"], ["j'habitais", "verb"], ["à la campagne", "place"]], "swap": { "role": "verb", "options": ["je jouais dehors", "je lisais beaucoup", "je nageais"] } },
    { "id": "fr-b1-07", "level": "B1", "fn": "Explain a reason", "topic": "opinions", "text": "Je le fais parce que ça m'aide à me détendre.", "en": "I do it because it helps me relax.", "keys": ["fais", "parce", "aide|m'aide"], "parts": [["Je le fais", "verb"], ["parce que", "connector"], ["ça m'aide à me détendre", "reason"]], "swap": { "role": "reason", "options": ["j'aime ça", "c'est bon pour la santé", "j'apprends beaucoup"] } },
    { "id": "fr-b1-08", "level": "B1", "fn": "Check understanding", "topic": "conversation", "text": "Tu veux dire que tu ne viens pas ?", "en": "Do you mean you're not coming?", "keys": ["veux", "dire", "viens"], "parts": [["Tu veux dire", "question"], ["que", "connector"], ["tu ne viens pas ?", "verb"]], "swap": { "role": "verb", "options": ["c'est fermé ?", "tu le savais ?", "il faut payer ?"] } },
    { "id": "fr-b1-09", "level": "B1", "fn": "Say what you've just done", "topic": "past", "text": "Je viens de rentrer à la maison.", "en": "I've just got home.", "keys": ["viens", "rentrer", "maison"], "parts": [["Je viens de", "verb"], ["rentrer", "infinitive"], ["à la maison", "place"]], "swap": { "role": "infinitive", "options": ["manger", "finir", "me réveiller"] } },
    { "id": "fr-b1-10", "level": "B1", "fn": "Express surprise", "topic": "feelings", "text": "Je n'en reviens pas !", "en": "I can't believe it!", "keys": ["reviens", "pas"], "parts": [["Je", "subject"], ["n'en reviens pas !", "verb"]], "swap": { "role": "verb", "options": ["ne m'y attendais pas !", "suis choqué !", "n'y crois pas !"] } },
    { "id": "fr-b1-11", "level": "B1", "fn": "Talk about a goal", "topic": "future", "text": "J'aimerais parler français couramment.", "en": "I'd like to speak French fluently.", "keys": ["aimerais|j'aimerais", "parler"], "parts": [["J'aimerais", "wish"], ["parler", "infinitive"], ["français couramment", "object"]], "swap": { "role": "infinitive", "options": ["voyager au Québec", "vivre en France", "comprendre les films"] } },
    { "id": "fr-b1-12", "level": "B1", "fn": "Make a complaint", "topic": "services", "text": "Excusez-moi, mais ça ne marche pas.", "en": "Excuse me, but this doesn't work.", "keys": ["excusez-moi", "mais", "marche"], "parts": [["Excusez-moi", "politeness"], ["mais", "connector"], ["ça", "subject"], ["ne marche pas", "verb"]], "swap": { "role": "subject", "options": ["la douche", "le wifi", "la carte"] } },

    { "id": "fr-b2-01", "level": "B2", "fn": "Speculate", "topic": "opinions", "text": "Il se peut qu'il soit en retard à cause des bouchons.", "en": "He might be late because of the traffic jams.", "keys": ["peut", "retard", "cause"], "parts": [["Il se peut qu'", "speculation"], ["il soit en retard", "verb"], ["à cause des bouchons", "reason"]], "swap": { "role": "reason", "options": ["à cause de la pluie", "à cause de la grève", "à cause du travail"] } },
    { "id": "fr-b2-02", "level": "B2", "fn": "Talk hypothetically", "topic": "hypotheses", "text": "Si j'avais plus de temps, j'apprendrais la guitare.", "en": "If I had more time, I'd learn the guitar.", "keys": ["si", "avais|j'avais", "temps"], "parts": [["Si j'avais plus de temps", "condition"], ["j'apprendrais", "verb"], ["la guitare", "object"]], "swap": { "role": "condition", "options": ["Si j'avais de l'argent", "Si j'habitais plus près", "Si j'étais toi"] } },
    { "id": "fr-b2-03", "level": "B2", "fn": "Weigh up pros and cons", "topic": "opinions", "text": "D'un côté c'est cher, mais de l'autre ça vaut le coup.", "en": "On the one hand it's expensive, but on the other it's worth it.", "keys": ["côté", "vaut", "coup"], "parts": [["D'un côté", "connector"], ["c'est cher", "complement"], ["mais de l'autre", "connector"], ["ça vaut le coup", "verb"]], "swap": { "role": "complement", "options": ["c'est difficile", "c'est loin", "ça prend du temps"] } },
    { "id": "fr-b2-04", "level": "B2", "fn": "Express certainty and doubt", "topic": "opinions", "text": "Je doute qu'ils finissent à temps.", "en": "I doubt they'll finish on time.", "keys": ["doute", "temps"], "parts": [["Je doute qu'", "doubt"], ["ils finissent", "verb"], ["à temps", "time"]], "swap": { "role": "doubt", "options": ["Je ne crois pas qu'", "Il est possible qu'", "Ça m'étonnerait qu'"] } },
    { "id": "fr-b2-05", "level": "B2", "fn": "Express regret", "topic": "feelings", "text": "J'aurais dû étudier davantage.", "en": "I should have studied more.", "keys": ["aurais|j'aurais", "dû"], "parts": [["J'aurais dû", "regret"], ["étudier", "infinitive"], ["davantage", "adverb"]], "swap": { "role": "infinitive", "options": ["y aller", "dire la vérité", "appeler"] } },
    { "id": "fr-b2-06", "level": "B2", "fn": "Persuade", "topic": "persuasion", "text": "Je t'assure que tu ne le regretteras pas.", "en": "I promise you won't regret it.", "keys": ["assure|t'assure", "regretteras"], "parts": [["Je t'assure que", "persuasion"], ["tu ne le regretteras pas", "verb"]], "swap": { "role": "persuasion", "options": ["Je suis convaincu que", "Tu verras,", "Crois-moi,"] } },
    { "id": "fr-b2-07", "level": "B2", "fn": "Report what someone said", "topic": "conversation", "text": "Elle m'a dit qu'elle viendrait plus tard.", "en": "She told me she'd come later.", "keys": ["dit", "viendrait", "tard"], "parts": [["Elle m'a dit qu'", "report"], ["elle viendrait", "verb"], ["plus tard", "time"]], "swap": { "role": "verb", "options": ["elle appellerait", "elle le ferait", "elle était occupée"] } },
    { "id": "fr-b2-08", "level": "B2", "fn": "Clarify what you meant", "topic": "conversation", "text": "Ce que je veux dire, c'est qu'il nous faut un plan.", "en": "What I mean is that we need a plan.", "keys": ["veux", "dire", "faut"], "parts": [["Ce que je veux dire, c'est qu'", "clarify"], ["il nous faut", "verb"], ["un plan", "object"]], "swap": { "role": "object", "options": ["plus de temps", "une autre option", "en parler"] } },
    { "id": "fr-b2-09", "level": "B2", "fn": "Set a condition", "topic": "negotiation", "text": "D'accord, à condition que tu me préviennes avant.", "en": "OK, as long as you let me know first.", "keys": ["d'accord", "condition", "préviennes"], "parts": [["D'accord", "reaction"], ["à condition que", "condition"], ["tu me préviennes avant", "verb"]], "swap": { "role": "condition", "options": ["pourvu que", "seulement si", "tant que"] } },
    { "id": "fr-b2-10", "level": "B2", "fn": "Talk about changes", "topic": "life", "text": "Depuis que j'ai déménagé, je me sens beaucoup mieux.", "en": "Since I moved, I feel much better.", "keys": ["depuis", "déménagé", "sens"], "parts": [["Depuis que j'ai déménagé", "time"], ["je me sens", "verb"], ["beaucoup mieux", "complement"]], "swap": { "role": "time", "options": ["Depuis que je cours", "Depuis que j'ai quitté ce travail", "Depuis que je vis seule"] } },
    { "id": "fr-b2-11", "level": "B2", "fn": "Give a strong recommendation", "topic": "advice", "text": "Je te conseille de le regarder en version originale.", "en": "I'd advise you to watch it in the original language.", "keys": ["conseille", "regarder"], "parts": [["Je te conseille de", "advice"], ["le regarder", "verb"], ["en version originale", "complement"]], "swap": { "role": "complement", "options": ["au plus vite", "avec des sous-titres", "entre amis"] } },
    { "id": "fr-b2-12", "level": "B2", "fn": "Show you're following", "topic": "conversation", "text": "Je vois, donc finalement tu n'y es pas allé.", "en": "I see, so in the end you didn't go.", "keys": ["vois", "donc", "finalement"], "parts": [["Je vois", "reaction"], ["donc", "connector"], ["finalement", "time"], ["tu n'y es pas allé", "verb"]], "swap": { "role": "verb", "options": ["tu es resté", "tu l'as acheté", "ils ont gagné"] } },

    { "id": "fr-c1-01", "level": "C1", "fn": "Hedge an opinion", "topic": "opinions", "text": "Dans une certaine mesure, je comprends leur position.", "en": "To some extent, I understand their position.", "keys": ["certaine", "mesure"], "parts": [["Dans une certaine mesure", "hedge"], ["je comprends", "verb"], ["leur position", "object"]], "swap": { "role": "hedge", "options": ["En partie", "D'une certaine manière", "Vu sous cet angle"] } },
    { "id": "fr-c1-02", "level": "C1", "fn": "Concede a point", "topic": "debate", "text": "Certes, mais ça ne change pas tout.", "en": "Admittedly, but that doesn't change everything.", "keys": ["certes", "change"], "parts": [["Certes", "concession"], ["mais", "connector"], ["ça ne change pas", "verb"], ["tout", "object"]], "swap": { "role": "concession", "options": ["Soit", "C'est vrai", "Je te l'accorde"] } },
    { "id": "fr-c1-03", "level": "C1", "fn": "Bring up a topic", "topic": "conversation", "text": "Au fait, tu as des nouvelles de Marc ?", "en": "By the way, have you heard from Marc?", "keys": ["fait", "nouvelles"], "parts": [["Au fait", "connector"], ["tu as des nouvelles", "verb"], ["de Marc ?", "object"]], "swap": { "role": "connector", "options": ["À propos", "Tant que j'y pense", "En parlant de ça"] } },
    { "id": "fr-c1-04", "level": "C1", "fn": "Emphasise", "topic": "opinions", "text": "Ce qui m'inquiète le plus, c'est le manque de temps.", "en": "What worries me most is the lack of time.", "keys": ["inquiète|m'inquiète", "manque"], "parts": [["Ce qui m'inquiète le plus", "emphasis"], ["c'est", "verb"], ["le manque de temps", "complement"]], "swap": { "role": "complement", "options": ["le prix", "la distance", "la pression"] } },
    { "id": "fr-c1-05", "level": "C1", "fn": "Buy time to think", "topic": "conversation", "text": "Alors, voyons, laisse-moi réfléchir une seconde.", "en": "So, let's see, let me think for a second.", "keys": ["alors", "voyons", "réfléchir"], "parts": [["Alors, voyons", "filler"], ["laisse-moi réfléchir", "verb"], ["une seconde", "time"]], "swap": { "role": "filler", "options": ["Bon", "Euh, je ne sais pas", "Disons que"] } },
    { "id": "fr-c1-06", "level": "C1", "fn": "Give a nuanced comparison", "topic": "opinions", "text": "Ce n'est pas tant l'argent que le temps perdu.", "en": "It's not so much the money as the time wasted.", "keys": ["tant", "que", "perdu"], "parts": [["Ce n'est pas tant", "comparison"], ["l'argent", "object"], ["que le temps perdu", "comparison"]], "swap": { "role": "object", "options": ["l'effort", "la distance", "le travail"] } },
    { "id": "fr-c1-07", "level": "C1", "fn": "Express mild criticism", "topic": "feedback", "text": "Ce n'est pas mal, même si ça pourrait être mieux.", "en": "It's not bad, though it could be better.", "keys": ["mal", "même", "pourrait"], "parts": [["Ce n'est pas mal", "evaluation"], ["même si", "connector"], ["ça pourrait être mieux", "verb"]], "swap": { "role": "verb", "options": ["il manque quelque chose", "c'est un peu long", "je changerais un détail"] } },
    { "id": "fr-c1-08", "level": "C1", "fn": "Summarise", "topic": "conversation", "text": "Bref, le mieux, c'est d'attendre.", "en": "In short, the best thing is to wait.", "keys": ["bref", "mieux", "attendre|d'attendre"], "parts": [["Bref", "connector"], ["le mieux, c'est", "evaluation"], ["d'attendre", "infinitive"]], "swap": { "role": "connector", "options": ["En somme", "Au bout du compte", "Finalement"] } },
    { "id": "fr-c1-09", "level": "C1", "fn": "Talk about consequences", "topic": "debate", "text": "Du coup, on a dû tout annuler.", "en": "So, we had to cancel everything.", "keys": ["coup", "dû", "annuler"], "parts": [["Du coup", "connector"], ["on a dû", "verb"], ["tout annuler", "infinitive"]], "swap": { "role": "connector", "options": ["Par conséquent", "C'est pour ça qu'", "Donc"] } },
    { "id": "fr-c1-10", "level": "C1", "fn": "Interrupt politely", "topic": "conversation", "text": "Pardon de t'interrompre, mais j'ai une question.", "en": "Sorry to interrupt, but I have a question.", "keys": ["pardon", "interrompre|t'interrompre", "question"], "parts": [["Pardon de t'interrompre", "politeness"], ["mais", "connector"], ["j'ai une question", "verb"]], "swap": { "role": "verb", "options": ["on manque de temps", "je ne suis pas d'accord", "je voulais ajouter quelque chose"] } },
    { "id": "fr-c1-11", "level": "C1", "fn": "Express indifference", "topic": "feelings", "text": "Ça m'est égal, c'est toi qui choisis.", "en": "I don't mind, you choose.", "keys": ["égal", "choisis"], "parts": [["Ça m'est égal", "reaction"], ["c'est toi qui choisis", "verb"]], "swap": { "role": "verb", "options": ["comme tu veux", "n'importe lequel", "décide, toi"] } },
    { "id": "fr-c1-12", "level": "C1", "fn": "Keep a promise vague", "topic": "social", "text": "Je ferai de mon mieux pour être là.", "en": "I'll do my best to be there.", "keys": ["ferai", "mieux"], "parts": [["Je ferai de mon mieux", "verb"], ["pour être là", "complement"]], "swap": { "role": "complement", "options": ["pour le finir", "pour arriver à l'heure", "pour t'aider"] } },

    { "id": "fr-c2-01", "level": "C2", "fn": "Use an idiom", "topic": "idioms", "text": "À quelque chose malheur est bon.", "en": "Every cloud has a silver lining.", "keys": ["malheur", "bon"], "parts": [["À quelque chose", "complement"], ["malheur", "subject"], ["est bon", "verb"]], "swap": null },
    { "id": "fr-c2-02", "level": "C2", "fn": "Downplay something", "topic": "conversation", "text": "Il n'y a pas de quoi en faire un drame.", "en": "It's nothing to make a fuss about.", "keys": ["quoi", "drame"], "parts": [["Il n'y a pas de quoi", "verb"], ["en faire", "infinitive"], ["un drame", "object"]], "swap": { "role": "object", "options": ["une histoire", "tout un plat", "une montagne"] } },
    { "id": "fr-c2-03", "level": "C2", "fn": "Reformulate precisely", "topic": "conversation", "text": "Ou plutôt, ce n'est pas que je ne veux pas, c'est que je ne peux pas.", "en": "Or rather, it's not that I don't want to, it's that I can't.", "keys": ["plutôt", "veux", "peux"], "parts": [["Ou plutôt", "clarify"], ["ce n'est pas que je ne veux pas", "contrast"], ["c'est que je ne peux pas", "reason"]], "swap": { "role": "reason", "options": ["c'est qu'on ne me laisse pas", "c'est que je n'ai pas le temps", "c'est que je ne sais pas"] } },
    { "id": "fr-c2-04", "level": "C2", "fn": "Sound ironic", "topic": "humour", "text": "Génial, il ne manquait plus que ça !", "en": "Great, that's all we needed!", "keys": ["manquait", "plus"], "parts": [["Génial", "reaction"], ["il ne manquait plus", "verb"], ["que ça !", "object"]], "swap": { "role": "reaction", "options": ["Parfait", "Super", "Formidable"] } },
    { "id": "fr-c2-05", "level": "C2", "fn": "Express resignation", "topic": "feelings", "text": "C'est comme ça, n'y pense plus.", "en": "That's how it is, stop thinking about it.", "keys": ["comme", "pense"], "parts": [["C'est comme ça", "reaction"], ["n'y pense plus", "verb"]], "swap": { "role": "verb", "options": ["il faut faire avec", "on n'y peut rien", "ça passera"] } },
    { "id": "fr-c2-06", "level": "C2", "fn": "Make a subtle suggestion", "topic": "persuasion", "text": "Ça ne ferait pas de mal de demander un deuxième avis.", "en": "It wouldn't hurt to ask for a second opinion.", "keys": ["ferait", "mal", "avis"], "parts": [["Ça ne ferait pas de mal de", "suggestion"], ["demander", "infinitive"], ["un deuxième avis", "object"]], "swap": { "role": "object", "options": ["plus d'informations", "de l'aide", "une réduction"] } },
    { "id": "fr-c2-07", "level": "C2", "fn": "Stress an exception", "topic": "debate", "text": "À quelques exceptions près, tout le monde était d'accord.", "en": "With a few exceptions, everyone agreed.", "keys": ["exceptions", "près"], "parts": [["À quelques exceptions près", "exception"], ["tout le monde", "subject"], ["était d'accord", "verb"]], "swap": { "role": "verb", "options": ["a voté pour", "est venu", "l'a accepté"] } },
    { "id": "fr-c2-08", "level": "C2", "fn": "Defend a view firmly", "topic": "debate", "text": "Tu as beau insister, je ne changerai pas d'avis.", "en": "However much you insist, I won't change my mind.", "keys": ["beau", "insister", "avis"], "parts": [["Tu as beau insister", "concession"], ["je ne changerai pas", "verb"], ["d'avis", "object"]], "swap": { "role": "concession", "options": ["Quoi que tu dises", "Même si tu me le demandes", "Tu peux toujours essayer"] } },
    { "id": "fr-c2-09", "level": "C2", "fn": "Show empathy", "topic": "feelings", "text": "Je me rends compte à quel point ça doit être dur.", "en": "I realise how hard it must be.", "keys": ["rends", "compte", "point"], "parts": [["Je me rends compte", "empathy"], ["à quel point", "emphasis"], ["ça doit être dur", "verb"]], "swap": { "role": "verb", "options": ["ça doit être épuisant", "ça doit être compliqué", "tu dois être fatigué"] } },
    { "id": "fr-c2-10", "level": "C2", "fn": "Signal a change of view", "topic": "debate", "text": "Tout bien réfléchi, tu as peut-être raison.", "en": "All things considered, maybe you're right.", "keys": ["réfléchi", "peut-être", "raison"], "parts": [["Tout bien réfléchi", "reconsider"], ["tu as peut-être raison", "verb"]], "swap": { "role": "verb", "options": ["il vaut mieux attendre", "ça n'en vaut pas la peine", "on devrait laisser tomber"] } },
    { "id": "fr-c2-11", "level": "C2", "fn": "Emphasise from every angle", "topic": "debate", "text": "Quelle que soit la façon dont on le voit, c'est une erreur.", "en": "Whichever way you look at it, it's a mistake.", "keys": ["quelle", "façon", "erreur"], "parts": [["Quelle que soit la façon dont on le voit", "emphasis"], ["c'est", "verb"], ["une erreur", "complement"]], "swap": { "role": "complement", "options": ["injuste", "une chance", "beaucoup trop cher"] } },
    { "id": "fr-c2-12", "level": "C2", "fn": "Close a discussion gracefully", "topic": "conversation", "text": "Restons-en là et on en reparle demain.", "en": "Let's leave it there and talk again tomorrow.", "keys": ["restons-en", "reparle", "demain"], "parts": [["Restons-en là", "verb"], ["et on en reparle", "verb"], ["demain", "time"]], "swap": { "role": "time", "options": ["la semaine prochaine", "après le déjeuner", "un autre jour"] } }
  ]
}
